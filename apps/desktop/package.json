{
  "name": "@pm-agent/desktop",
  "version": "0.1.6",
  "private": true,
  "author": "DualMind",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist": "node ../../scripts/prepare-package-assets.mjs --strict-figma && electron-vite build && electron-builder"
  },
  "build": {
    "appId": "com.dualmind.desktop",
    "productName": "DualMind",
    "directories": { "output": "release", "buildResources": "build" },
    "asarUnpack": ["**/*.node"],
    "files": ["out/main/**/*", "out/preload/**/*", "out/renderer/**/*", "package.json"],
    "publish": [{ "provider": "github", "owner": "vtd182", "repo": "ZA-ai-hackathon-26" }],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "identity": null,
      "extraResources": [
        { "from": "out/package-resources/skill-packs", "to": "skill-packs" },
        { "from": "out/package-resources/figma-runtime", "to": "figma-runtime" }
      ]
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png",
      "extraResources": [
        { "from": "out/package-resources/skill-packs", "to": "skill-packs" },
        { "from": "out/package-resources/figma-runtime", "to": "figma-runtime" }
      ]
    }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.112.5",
    "@fontsource-variable/inter": "^5.3.0",
    "@google/genai": "2.13.0",
    "@pm-agent/agent-core": "workspace:*",
    "@pm-agent/canvas": "workspace:*",
    "@pm-agent/connectors": "workspace:*",
    "@pm-agent/domain": "workspace:*",
    "@pm-agent/fixture-meal-ordering": "workspace:*",
    "@pm-agent/fixture-zalo-design-system": "workspace:*",
    "@pm-agent/persistence": "workspace:*",
    "@pm-agent/reasoning": "workspace:*",
    "@tldraw/assets": "5.2.5",
    "better-sqlite3": "13.0.1",
    "lucide-react": "1.25.0",
    "openai": "6.48.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tldraw": "5.2.5"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "5.0.0",
    "typescript": "7.0.2",
    "vite": "7.3.6"
  }
}
